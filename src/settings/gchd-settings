#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# gchd-settings: settings of the Elgato Game Capture HD (elgato_gchd
# driver) in a text menu: input, output size, bitrate, stretch of SD input,
# for HDMI and component "Allow 50/60 fps", for HDMI the colour range,
# picture settings, analog audio gain. The driver remembers the settings.
#
#   gchd-settings [DEVICE]      DEVICE: default /dev/elgato-gchd, else the
#                               first device of the driver
#
# Changes apply at once, also to a running capture.
#
# Needs: whiptail (package whiptail), v4l2-ctl (package v4l-utils).

set -u

TITLE="Elgato Game Capture HD"

die() { echo "gchd-settings: $*" >&2; exit 1; }

find_dev() {
	local v drv
	[ -e /dev/elgato-gchd ] && { echo /dev/elgato-gchd; return 0; }
	for v in /sys/class/video4linux/video*; do
		drv=$(basename "$(readlink -f "$v/device/driver" 2>/dev/null)")
		[ "$drv" = elgato_gchd ] && { echo "/dev/$(basename "$v")"; return 0; }
	done
	return 1
}

command -v whiptail >/dev/null || die "whiptail is needed (package whiptail)"
command -v v4l2-ctl >/dev/null || die "v4l2-ctl is needed (package v4l-utils)"
DEV=${1:-$(find_dev)} || die "no Elgato Game Capture HD found (driver loaded, device plugged in?)"
[ -e "$DEV" ] || die "$DEV not found"

ctrl_get() { v4l2-ctl -d "$DEV" -C "$1" 2>/dev/null | sed -n 's/.*: //p'; }
input_get() { v4l2-ctl -d "$DEV" -I 2>/dev/null | sed -n 's/^Video input *: *\([0-9]\).*/\1/p'; }
size_get() { v4l2-ctl -d "$DEV" -V 2>/dev/null | sed -n 's#.*Width/Height *: *\([0-9]*\)/\([0-9]*\).*#\1x\2#p'; }

# Run a v4l2-ctl change; on "busy" explain that a program is capturing.
apply() {	# apply DESCRIPTION ARGS...
	local desc=$1 out
	shift
	if out=$(v4l2-ctl -d "$DEV" "$@" 2>&1); then
		return 0
	fi
	if printf '%s' "$out" | grep -qi busy; then
		whiptail --title "$TITLE" --msgbox "$desc cannot be changed while a program captures from the device. Stop the capture (for example hide the source in OBS) and try again." 10 70
	else
		whiptail --title "$TITLE" --msgbox "$desc: $out" 10 70
	fi
	return 1
}

menu_input() {
	local cur n
	cur=$(input_get)
	n=$(whiptail --title "$TITLE" --default-item "${cur:-2}" --menu "Input" 14 50 4 \
		0 HDMI 1 Component 2 Composite 3 S-Video 3>&1 1>&2 2>&3) || return
	apply "The input" -i "$n"
}

menu_output() {
	local cur n w h
	cur=$(size_get)
	case "$cur" in 640x480) n=1 ;; 480x360) n=2 ;; *) n=0 ;; esac
	n=$(whiptail --title "$TITLE" --default-item "$n" --menu \
		"Output size (composite and S-video)" 14 60 3 \
		0 "720x480 NTSC / 720x576 PAL" \
		1 "640x480" 2 "480x360" 3>&1 1>&2 2>&3) || return
	case "$n" in
	1) w=640 h=480 ;; 2) w=480 h=360 ;; *) w=720 h=480 ;;
	esac
	apply "The output size" -v "width=$w,height=$h"
}

# Component: the resolutions the source allows (the source size first).
menu_comp_output() {
	local sizes n i=0 args=() cur w h s
	mapfile -t sizes < <(v4l2-ctl -d "$DEV" --list-framesizes MPEG 2>/dev/null | sed -n 's/.*Discrete \([0-9]*x[0-9]*\).*/\1/p')
	[ ${#sizes[@]} -gt 0 ] || { whiptail --msgbox "No output sizes (no signal?)" 8 40; return; }
	local def=0
	cur=$(size_get)
	for s in "${sizes[@]}"; do
		[ "$s" = "$cur" ] && def=$i
		args+=("$i" "$s"); i=$((i + 1))
	done
	n=$(whiptail --title "$TITLE" --default-item "$def" \
		--menu "Output size (HDMI/component)" 14 50 4 "${args[@]}" 3>&1 1>&2 2>&3) || return
	# The source size is requested as 1920x1080 (never a scaled size).
	if [ "$n" = 0 ]; then w=1920 h=1080; else w=${sizes[$n]%x*} h=${sizes[$n]#*x}; fi
	apply "The output size" -v "width=$w,height=$h"
}

menu_allow() {
	local cur n
	cur=$(ctrl_get allow_50_60_fps)
	n=$(whiptail --title "$TITLE" --default-item "${cur:-1}" --menu \
		"Allow 50/60 fps (HDMI/component: 720p at 60, 480p/576p short GOP)" 12 60 2 \
		1 On 0 Off 3>&1 1>&2 2>&3) || return
	apply "Allow 50/60 fps" -c "allow_50_60_fps=$n"
}

# Bitrate as the settings window's slider, in Mbit/s: below 10.00 variable
# (VBR, the average: half the bitrate), from 10.00 constant (CBR) up to the
# output's highest (the bitrate control's default); 480x360 VBR only,
# 2.00-7.50.
bitrate_shown() {
	local b m
	b=$(ctrl_get video_bitrate); m=$(ctrl_get video_bitrate_mode)
	if [ "$m" = 0 ] || [ "$(size_get)" = 480x360 ]; then
		awk -v b="${b:-0}" 'BEGIN { printf "%.2f Mbit/s (VBR)", b / 2e6 }'
	else
		awk -v b="${b:-0}" 'BEGIN { printf "%.2f Mbit/s (CBR)", b / 1e6 }'
	fi
}

menu_bitrate() {
	local top lo hi v mobile=0 args
	top=$(v4l2-ctl -d "$DEV" -l 2>/dev/null | sed -n 's/^ *video_bitrate .*default=\([0-9]*\).*/\1/p')
	[ "$(size_get)" = 480x360 ] && mobile=1
	if [ "$mobile" = 1 ]; then
		lo=2.00 hi=7.50
	else
		lo=$(awk -v t="${top:-11250000}" 'BEGIN { printf "%.2f", t * 8 / 15 / 2e6 }')
		hi=$(awk -v t="${top:-11250000}" 'BEGIN { printf "%.2f", t / 1e6 }')
	fi
	v=$(whiptail --title "$TITLE" --inputbox \
		"Bitrate in Mbit/s, $lo to $hi ($( [ "$mobile" = 1 ] && echo "VBR only, the average" || echo "below 10.00 VBR, the average; from 10.00 CBR"))" 10 70 \
		"$(bitrate_shown | cut -d' ' -f1)" 3>&1 1>&2 2>&3) || return
	args=$(awk -v v="$v" -v lo="$lo" -v hi="$hi" -v m="$mobile" 'BEGIN {
		if (v !~ /^[0-9]+([.][0-9]*)?$/ || v + 0 < lo - 0.0001 || v + 0 > hi + 0.0001) exit 1
		c = int(v * 100 + 0.5)
		if (m == 1 || c < 1000) printf "video_bitrate_mode=0,video_bitrate=%d", c * 20000
		else printf "video_bitrate_mode=1,video_bitrate=%d", c * 10000 }') ||
		{ whiptail --msgbox "Not between $lo and $hi: $v" 8 50; return; }
	apply "The bitrate" -c "$args"
}

menu_range() {
	local cur n
	cur=$(ctrl_get hdmi_color_range)
	n=$(whiptail --title "$TITLE" --default-item "${cur:-0}" --menu \
		"HDMI color range (RGB sources)" 12 50 2 \
		0 Standard 1 Expanded 3>&1 1>&2 2>&3) || return
	apply "The HDMI color range" -c "hdmi_color_range=$n"
}

menu_stretch() {
	local cur n
	cur=$(ctrl_get stretch_sd_input)
	n=$(whiptail --title "$TITLE" --default-item "${cur:-0}" --menu \
		"Stretch SD input (composite and S-video)" 12 50 2 \
		0 Off 1 On 3>&1 1>&2 2>&3) || return
	apply "Stretch" -c "stretch_sd_input=$n"
}

# value_menu CONTROL LABEL LOW HIGH: a whole number in LOW ... HIGH.
value_menu() {
	local cur v
	cur=$(ctrl_get "$1")
	v=$(whiptail --title "$TITLE" --inputbox "$2 ($3 to $4, 0 neutral)" 10 60 \
		"${cur:-0}" 3>&1 1>&2 2>&3) || return
	{ [[ "$v" =~ ^-?[0-9]+$ ]] && [ "$v" -ge "$3" ] && [ "$v" -le "$4" ]; } ||
		{ whiptail --msgbox "Not between $3 and $4: $v" 8 50; return; }
	apply "$2" -c "$1=$v"
}

menu_picture() {
	local n
	n=$(whiptail --title "$TITLE" --menu "Picture" 15 60 5 \
		brightness "Brightness: $(ctrl_get brightness)" \
		contrast "Contrast: $(ctrl_get contrast)" \
		saturation "Saturation: $(ctrl_get saturation)" \
		hue "Hue: $(ctrl_get hue) degrees" \
		reset "Reset (all 0)" 3>&1 1>&2 2>&3) || return
	case "$n" in
	hue) value_menu hue "Hue in degrees" -180 180 ;;
	reset) apply "The picture settings" -c "brightness=0,contrast=0,saturation=0,hue=0" ;;
	*) value_menu "$n" "${n^}" -100 100 ;;
	esac
}

while :; do
	inputs=(HDMI Component Composite S-Video)
	i=$(input_get)
	items=(input "Input: ${inputs[${i:-0}]}")
	# Output size and bitrate for every input; stretch composite/S-video;
	# 50/60 fps HDMI and component; colour range HDMI.
	if [ "${i:-0}" -ge 2 ]; then
		items+=(output "Output size: $(size_get)"
			bitrate "Bitrate: $(bitrate_shown)")
	else
		items+=(compout "Output size: $(size_get)"
			bitrate "Bitrate: $(bitrate_shown)"
			allow "Allow 50/60 fps: $( [ "$(ctrl_get allow_50_60_fps)" = 0 ] && echo off || echo on )")
	fi
	if [ "${i:-0}" = 0 ]; then
		items+=(range "HDMI color range: $( [ "$(ctrl_get hdmi_color_range)" = 1 ] && echo Expanded || echo Standard )")
	fi
	if [ "${i:-0}" -ge 2 ]; then
		items+=(stretch "Stretch SD input: $( [ "$(ctrl_get stretch_sd_input)" = 1 ] && echo on || echo off )")
	fi
	items+=(picture "Picture: brightness $(ctrl_get brightness), contrast $(ctrl_get contrast), saturation $(ctrl_get saturation), hue $(ctrl_get hue)")
	if [ "${i:-0}" -ge 1 ]; then
		items+=(gain "Audio gain: $(ctrl_get analog_audio_gain_db) dB")
	fi
	choice=$(whiptail --title "$TITLE ($DEV)" --menu "Settings (remembered by the driver)" 20 90 10 \
		"${items[@]}" quit "Quit" 3>&1 1>&2 2>&3) || break
	case "$choice" in
	input) menu_input ;;
	output) menu_output ;;
	bitrate) menu_bitrate ;;
	range) menu_range ;;
	picture) menu_picture ;;
	gain) value_menu analog_audio_gain_db "Audio gain in dB" -12 12 ;;
	stretch) menu_stretch ;;
	compout) menu_comp_output ;;
	allow) menu_allow ;;
	*) break ;;
	esac
done
