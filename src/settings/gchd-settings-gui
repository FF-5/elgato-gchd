"""Elgato Game Capture HD settings: a window with the settings of the
elgato_gchd driver (input, output size, bitrate, bitrate mode, H.264
profile, stretch of SD input). Changes are applied at once; the driver
remembers them. Input and output size can be changed only while no program
captures from the device.

    gchd-settings-gui [DEVICE]   DEVICE: default /dev/elgato-gchd, else the
                                 first device of the driver

Needs: python3-gi, gir1.2-gtk-3.0, v4l2-ctl (v4l-utils).
"""

import os
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

TITLE = "Elgato Game Capture HD"
INPUTS = ["HDMI", "Component", "Composite", "S-Video"]
OUTPUTS = [("Source size (720x480 NTSC / 720x576 PAL)", 720, 480),
           ("640x480", 640, 480), ("480x360", 480, 360)]
MODES = [("Constant (CBR), 11250 kbit/s", 1), ("Variable (VBR)", 0)]

# Bitrate settings as the device's capture application uses them for
# composite and S-video (kbit/s): CBR only at 11250; VBR from 6000 to
# 14460 for the standard and 640x480 sizes, 4000 to 15000 for 480x360
# (always VBR).
CBR_KBPS = 11250
VBR_RANGE = {0: (6000, 14460), 1: (6000, 14460), 2: (4000, 15000)}
STEP_KBPS = 20
PROFILES = [("High", 4), ("Main", 2), ("Baseline", 0)]
BUSY_TEXT = ("A program is capturing from the device: input and output size "
             "can be changed only while no program captures (for example "
             "hide the source in OBS).")


def find_device():
    if os.path.exists("/dev/elgato-gchd"):
        return "/dev/elgato-gchd"
    base = "/sys/class/video4linux"
    try:
        names = sorted(os.listdir(base), key=lambda n: int(n[5:] or 0))
    except (OSError, ValueError):
        return None
    for name in names:
        drv = os.path.realpath(os.path.join(base, name, "device", "driver"))
        if os.path.basename(drv) == "elgato_gchd":
            return "/dev/" + name
    return None


class Device:
    """The driver's video device, through v4l2-ctl."""

    def __init__(self, path):
        self.path = path

    def run(self, *args):
        p = subprocess.run(["v4l2-ctl", "-d", self.path, *args],
                           capture_output=True, text=True)
        return p.returncode, p.stdout + p.stderr

    def ctrl(self, name, default=None):
        rc, out = self.run("-C", name)
        m = re.search(r":\s*(-?\d+)", out)
        return int(m.group(1)) if rc == 0 and m else default

    def input(self):
        rc, out = self.run("-I")
        m = re.search(r"Video input\s*:\s*(\d)", out)
        return int(m.group(1)) if rc == 0 and m else 0

    def size(self):
        rc, out = self.run("-V")
        m = re.search(r"Width/Height\s*:\s*(\d+)/(\d+)", out)
        return (int(m.group(1)), int(m.group(2))) if rc == 0 and m else None


class Window(Gtk.Window):
    def __init__(self, path):
        super().__init__(title=TITLE + " Settings")
        self.set_border_width(12)
        self.set_default_size(480, -1)
        self.dev = None
        self.loading = False
        self.bitrate_timer = 0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        box.pack_start(grid, False, False, 0)

        def label(text, row):
            lab = Gtk.Label(label=text, xalign=0)
            grid.attach(lab, 0, row, 1, 1)

        def combo(items, row, handler):
            c = Gtk.ComboBoxText()
            for text in items:
                c.append_text(text)
            c.set_hexpand(True)
            c.connect("changed", handler)
            grid.attach(c, 1, row, 1, 1)
            return c

        label("Device", 0)
        self.device_label = Gtk.Label(xalign=0)
        self.device_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        grid.attach(self.device_label, 1, 0, 1, 1)

        label("Input", 1)
        self.input = combo(INPUTS, 1, self.on_input)
        label("Output size", 2)
        self.output = combo([o[0] for o in OUTPUTS], 2, self.on_output)

        label("Bitrate mode", 3)
        self.mode = combo([m[0] for m in MODES], 3, self.on_mode)

        label("Bitrate (VBR)", 4)
        self.bitrate = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 6000, 14460, STEP_KBPS)
        self.bitrate.set_digits(0)
        self.bitrate.set_value_pos(Gtk.PositionType.BOTTOM)
        self.bitrate.connect("format-value", self.format_bitrate)
        self.bitrate.connect("value-changed", self.on_bitrate)
        grid.attach(self.bitrate, 1, 4, 1, 1)
        label("H.264 profile", 5)
        self.profile = combo([p[0] for p in PROFILES], 5, self.on_profile)

        label("Stretch SD input", 6)
        self.stretch = Gtk.Switch(halign=Gtk.Align.START)
        self.stretch.connect("notify::active", self.on_stretch)
        grid.attach(self.stretch, 1, 6, 1, 1)

        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.set_max_width_chars(60)
        box.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(spacing=6)
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda _b: self.load())
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _b: self.close())
        buttons.pack_end(close, False, False, 0)
        buttons.pack_end(refresh, False, False, 0)
        box.pack_end(buttons, False, False, 0)

        self.fixed_path = path
        self.load()

    # ------------------------------------------------------------ state

    def say(self, text):
        self.status.set_text(text)

    def load(self):
        """Read the device's settings into the widgets."""
        path = self.fixed_path or find_device()
        self.loading = True
        try:
            if not path or not os.path.exists(path):
                self.dev = None
                self.device_label.set_text("not found")
                self.say("No Elgato Game Capture HD found: driver loaded, "
                         "device plugged in? Then press Refresh.")
                self.set_controls(False)
                return
            self.dev = Device(path)
            self.device_label.set_text(path)
            self.set_controls(True)
            inp = self.dev.input()
            self.input.set_active(inp)
            size = self.dev.size()
            out = 0
            if size == (640, 480):
                out = 1
            elif size == (480, 360):
                out = 2
            self.output.set_active(out)
            self.output.set_sensitive(inp >= 2)
            self.stretch.set_sensitive(inp >= 2)
            mode = self.dev.ctrl("video_bitrate_mode", 1)
            self.mode.set_active(0 if mode == 1 else 1)
            self.bitrate.set_value(self.dev.ctrl("video_bitrate", 11250000) / 1000)
            self.update_bitrate_controls()
            prof = self.dev.ctrl("h264_profile", 4)
            self.profile.set_active(
                next((i for i, p in enumerate(PROFILES) if p[1] == prof), 0))
            self.stretch.set_active(bool(self.dev.ctrl("stretch_sd_input", 0)))
            self.say("Changes are applied at once and remembered by the driver.")
        finally:
            self.loading = False

    def set_controls(self, on):
        for w in (self.input, self.output, self.bitrate, self.mode,
                  self.profile, self.stretch):
            w.set_sensitive(on)

    def apply(self, what, *args):
        """Run a change; on 'busy' explain and reload."""
        if self.loading or not self.dev:
            return True
        rc, out = self.dev.run(*args)
        if rc == 0:
            self.say(what + " changed.")
            return True
        text = BUSY_TEXT if "busy" in out.lower() else what + ": " + out.strip()
        self.say(text)
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK,
                                   text=what + " not changed")
        dialog.format_secondary_text(text)
        dialog.run()
        dialog.destroy()
        GLib.idle_add(self.load_keep_status)
        return False

    def load_keep_status(self):
        text = self.status.get_text()
        self.load()
        self.say(text)
        return False

    def vbr_range(self):
        return VBR_RANGE.get(max(self.output.get_active(), 0), VBR_RANGE[0])

    def format_bitrate(self, _scale, value):
        if self.mode.get_active() != 1:
            return "%d kbit/s constant" % CBR_KBPS
        return "%d kbit/s (average %.1f Mbit/s)" % (value, value / 2000)

    def update_bitrate_controls(self):
        """Mode and slider limits for the output size (480x360: VBR only)."""
        mobile = self.output.get_active() == 2 and self.input.get_active() >= 2
        if mobile and self.mode.get_active() != 1:
            self.mode.set_active(1)
        self.mode.set_sensitive(self.dev is not None and not mobile)
        lo, hi = self.vbr_range()
        adj = self.bitrate.get_adjustment()
        adj.set_lower(lo)
        adj.set_upper(hi)
        if not lo <= self.bitrate.get_value() <= hi:
            self.bitrate.set_value(min(max(self.bitrate.get_value(), lo), hi))
        vbr = self.mode.get_active() == 1
        self.bitrate.set_sensitive(self.dev is not None and vbr)

    def apply_rate(self):
        """Bitrate mode and value as the capture application sets them."""
        if self.loading or not self.dev:
            return
        if self.mode.get_active() == 1:
            kb = int(round(self.bitrate.get_value() / STEP_KBPS)) * STEP_KBPS
            self.apply("Bitrate", "-c", "video_bitrate_mode=0,video_bitrate=%d"
                       % (kb * 1000))
        else:
            self.apply("Bitrate", "-c", "video_bitrate_mode=1,video_bitrate=%d"
                       % (CBR_KBPS * 1000))

    # ------------------------------------------------------------ handlers

    def on_input(self, c):
        i = c.get_active()
        if i < 0:
            return
        if self.apply("Input", "-i", str(i)):
            GLib.idle_add(self.load_keep_status)

    def on_output(self, c):
        i = c.get_active()
        if i < 0:
            return
        _, w, h = OUTPUTS[i]
        if self.apply("Output size", "-v", "width=%d,height=%d" % (w, h)):
            self.loading, was = True, self.loading
            self.update_bitrate_controls()
            self.loading = was
            self.apply_rate()

    def on_bitrate(self, s):
        if self.loading:
            return
        if self.bitrate_timer:
            GLib.source_remove(self.bitrate_timer)
        self.bitrate_timer = GLib.timeout_add(400, self.apply_bitrate)

    def apply_bitrate(self):
        self.bitrate_timer = 0
        self.apply_rate()
        return False

    def on_mode(self, c):
        if c.get_active() < 0 or self.loading:
            return
        self.loading = True
        self.update_bitrate_controls()
        self.loading = False
        self.apply_rate()

    def on_profile(self, c):
        i = c.get_active()
        if i >= 0:
            self.apply("H.264 profile", "-c", "h264_profile=%d" % PROFILES[i][1])

    def on_stretch(self, sw, _param):
        self.apply("Stretch", "-c", "stretch_sd_input=%d" % int(sw.get_active()))


def main():
    if subprocess.run(["sh", "-c", "command -v v4l2-ctl"],
                      capture_output=True).returncode:
        print("gchd-settings-gui: v4l2-ctl is needed (package v4l-utils)",
              file=sys.stderr)
        return 1
    win = Window(sys.argv[1] if len(sys.argv) > 1 else None)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
