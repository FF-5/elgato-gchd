"""Elgato Game Capture HD settings: a window with the settings of the
elgato_gchd driver (input, output size, bitrate mode and bitrate, H.264
profile, stretch of SD input). Changes are applied at once, also while a
program captures, and the driver remembers them. The window shows changes
made by other programs (it reads the device every 1.5 s).

    gchd-settings-gui [DEVICE]   DEVICE: default /dev/elgato-gchd, else the
                                 first device of the driver

Needs: python3-gi, gir1.2-gtk-3.0, v4l2-ctl (v4l-utils).
"""

import os
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

TITLE = "Elgato Game Capture HD"
INPUTS = ["HDMI", "Component", "Composite", "S-Video"]
OUTPUTS = [("720x480", 720, 480),
           ("640x480", 640, 480), ("480x360", 480, 360)]
MODES = [("Constant (CBR)", 1), ("Variable (VBR)", 0)]
PROFILES = [("High", 4), ("Main", 2), ("Baseline", 0)]
REFRESH_MS = 1500

# Bitrate of composite and S-video in Mbit/s as the device's capture
# application shows it: VBR as the average (half the bitrate): 3.0-7.23
# (bitrate 6000-14460 kbit/s) for the standard and 640x480 sizes, 2.0-7.5
# (4000-15000) for 480x360, which is always VBR; CBR as the bitrate:
# 7.0-11.25 (the application uses 11250 only).
# kbit/s per 0.01 Mbit/s shown: CBR the bitrate (10), VBR the average (20).
VBR_RANGE = {0: (3.0, 7.23, 7.0), 1: (3.0, 7.23, 7.0), 2: (2.0, 7.5, 7.5)}
CBR_RANGE = (7.0, 11.25, 11.25)


def find_device():
    if os.path.exists("/dev/elgato-gchd"):
        return "/dev/elgato-gchd"
    base = "/sys/class/video4linux"
    try:
        names = sorted(os.listdir(base), key=lambda n: int(n[5:] or 0))
    except (OSError, ValueError):
        return None
    for name in names:
        drv = os.path.realpath(os.path.join(base, name, "device", "driver"))
        if os.path.basename(drv) == "elgato_gchd":
            return "/dev/" + name
    return None


class Device:
    """The driver's video device, through v4l2-ctl."""

    def __init__(self, path):
        self.path = path

    def run(self, *args):
        p = subprocess.run(["v4l2-ctl", "-d", self.path, *args],
                           capture_output=True, text=True)
        return p.returncode, p.stdout + p.stderr

    def read(self):
        """All settings in one call, or None when the device is gone."""
        rc, out = self.run("-I", "-V", "-S", "-C",
                           "video_bitrate,video_bitrate_mode,h264_profile,"
                           "stretch_sd_input")
        if rc != 0:
            return None

        def num(pattern, default):
            m = re.search(pattern, out)
            return int(m.group(1)) if m else default

        m = re.search(r"Width/Height\s*:\s*(\d+)/(\d+)", out)
        std = re.search(r"Video Standard\s*=\s*0x([0-9a-fA-F]+)", out)
        return {
            # Last detected composite/S-video standard 50 Hz (PAL family).
            "pal": bool(std and int(std.group(1), 16) & 0x00ff06ff),
            "input": num(r"Video input\s*:\s*(\d)", 0),
            "size": (int(m.group(1)), int(m.group(2))) if m else None,
            "bitrate": num(r"video_bitrate:\s*(\d+)", 11250000),
            "mode": num(r"video_bitrate_mode:\s*(\d+)", 1),
            "profile": num(r"h264_profile:\s*(\d+)", 4),
            "stretch": num(r"stretch_sd_input:\s*(\d+)", 0),
        }


class Window(Gtk.Window):
    def __init__(self, path):
        super().__init__(title=TITLE + " Settings")
        self.set_border_width(12)
        self.set_default_size(480, -1)
        self.fixed_path = path
        self.dev = None
        self.loading = False
        self.dragging = False
        self.rate_timer = 0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        box.pack_start(grid, False, False, 0)

        def label(text, row):
            lab = Gtk.Label(label=text, xalign=0)
            grid.attach(lab, 0, row, 1, 1)
            return lab

        def combo(items, row, handler):
            c = Gtk.ComboBoxText()
            for text in items:
                c.append_text(text)
            c.set_hexpand(True)
            c.connect("changed", handler)
            grid.attach(c, 1, row, 1, 1)
            return c

        label("Device", 0)
        self.device_label = Gtk.Label(xalign=0)
        self.device_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        grid.attach(self.device_label, 1, 0, 1, 1)
        label("Input", 1)
        self.input = combo(INPUTS, 1, self.on_input)
        self.output_label = label("Output size", 2)
        self.output = combo([o[0] for o in OUTPUTS], 2, self.on_output)
        self.mode_label = label("Bitrate mode", 3)
        self.mode = combo([m[0] for m in MODES], 3, self.on_mode)

        self.rate_label = label("Bitrate", 4)
        self.rate = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, CBR_RANGE[0], CBR_RANGE[1], 0.01)
        self.rate.set_digits(2)
        self.rate.set_value_pos(Gtk.PositionType.RIGHT)
        self.rate.connect("format-value",
                          lambda _s, v: "%.2f Mbit/s" % v)
        self.rate.connect("value-changed", self.on_rate)
        self.rate.connect("button-press-event", self.on_press)
        self.rate.connect("button-release-event", self.on_release)
        grid.attach(self.rate, 1, 4, 1, 1)

        label("H.264 profile", 5)
        self.profile = combo([p[0] for p in PROFILES], 5, self.on_profile)
        self.stretch_label = label("Stretch SD input", 6)
        self.stretch = Gtk.Switch(halign=Gtk.Align.START)
        self.stretch.connect("notify::active", self.on_stretch)
        grid.attach(self.stretch, 1, 6, 1, 1)

        # Status next to the Close button.
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.set_max_width_chars(45)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _b: self.close())
        buttons = Gtk.Box(spacing=12)
        buttons.pack_start(self.status, True, True, 0)
        buttons.pack_end(close, False, False, 0)
        box.pack_end(buttons, False, False, 0)
        self.pending = 0  # device commands running

        self.load()
        GLib.timeout_add(REFRESH_MS, self.refresh)

    # ------------------------------------------------------------ state

    def busy_with_user(self):
        """True while the user is changing something (no refresh then)."""
        if self.dragging or self.rate_timer or self.pending:
            return True
        return any(c.get_property("popup-shown")
                   for c in (self.input, self.output, self.mode, self.profile))

    def refresh(self):
        if not self.busy_with_user():
            self.load(quiet=True)
        return True

    def rate_range(self):
        out = max(self.output.get_active(), 0)
        if out == 2 or self.mode.get_active() == 1:
            return VBR_RANGE[out]
        return CBR_RANGE

    def load(self, quiet=False):
        """Read the device's settings into the widgets."""
        path = self.fixed_path or find_device()
        vals = Device(path).read() if path and os.path.exists(path) else None
        self.loading = True
        try:
            if vals is None:
                self.dev = None
                self.device_label.set_text("not found")
                self.status.set_text("No Elgato Game Capture HD found (driver "
                                     "loaded, device plugged in?).")
                self.set_controls(False)
                return
            was_missing = self.dev is None
            self.dev = Device(path)
            self.device_label.set_text(path)
            self.set_controls(True)
            self.set_active(self.input, vals["input"])
            source = "720x576" if vals["pal"] else "720x480"
            self.set_output_name(source)
            out = {(640, 480): 1, (480, 360): 2}.get(vals["size"], 0)
            self.set_active(self.output, out)
            analog = vals["input"] >= 2
            # Composite/S-video only (HDMI/component: their own settings).
            for w in (self.output_label, self.output, self.stretch_label,
                      self.stretch, self.mode_label, self.mode,
                      self.rate_label, self.rate):
                w.set_visible(analog)
            mobile = analog and out == 2
            self.set_active(self.mode, 1 if mobile or vals["mode"] == 0 else 0)
            self.mode.set_sensitive(not mobile)
            lo, hi, _ = self.rate_range()
            vbr = self.mode.get_active() == 1
            shown = vals["bitrate"] / (2000000 if vbr else 1000000)
            adj = self.rate.get_adjustment()
            adj.set_lower(lo)
            adj.set_upper(hi)
            if abs(self.rate.get_value() - shown) > 0.005:
                self.rate.set_value(min(max(shown, lo), hi))
            self.set_active(self.profile, next(
                (i for i, p in enumerate(PROFILES) if p[1] == vals["profile"]), 0))
            if self.stretch.get_active() != bool(vals["stretch"]):
                self.stretch.set_active(bool(vals["stretch"]))
            if not quiet or was_missing:
                self.status.set_text("Changes apply at once and are kept.")
        finally:
            self.loading = False

    def set_output_name(self, source):
        """First output size: the source size of the last standard."""
        model = self.output.get_model()
        if model[0][0] != source:
            model[0][0] = source

    @staticmethod
    def set_active(combo, index):
        if combo.get_active() != index:
            combo.set_active(index)

    def set_controls(self, on):
        for w in (self.input, self.output, self.rate, self.mode,
                  self.profile, self.stretch):
            w.set_sensitive(on)

    def apply(self, what, *args):
        """Run a change in the background (the device may take a while);
        report it, read the settings back, show a message box on an error."""
        if self.loading or not self.dev:
            return
        dev = self.dev
        self.pending += 1
        self.status.set_text("Changing " + what.lower() + " ...")

        def work():
            rc, out = dev.run(*args)
            GLib.idle_add(self.applied, what, rc, out)

        threading.Thread(target=work, daemon=True).start()

    def applied(self, what, rc, out):
        self.pending -= 1
        if rc == 0:
            self.status.set_text(what + " changed.")
        else:
            self.status.set_text(what + " not changed.")
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                       message_type=Gtk.MessageType.WARNING,
                                       buttons=Gtk.ButtonsType.OK,
                                       text=what + " not changed")
            dialog.format_secondary_text(out.strip())
            dialog.run()
            dialog.destroy()
        if not self.pending:
            self.load(quiet=True)
        return False

    def apply_rate(self):
        """Bitrate (kbit/s from the shown Mbit/s) in the current mode."""
        lo, hi, default = self.rate_range()
        value = self.rate.get_value()
        if not lo - 1e-6 <= value <= hi + 1e-6:
            value = default
        vbr = self.mode.get_active() == 1 or self.output.get_active() == 2
        # Hundredths of Mbit/s, rounded half up (11.25 -> 11250 kbit/s).
        kb = int(value * 100 + 0.5) * (20 if vbr else 10)
        self.apply("Bitrate", "-c", "video_bitrate=%d" % (kb * 1000))

    def limits_changed(self):
        """New slider range after a mode or size change (the value follows
        with the next read: the driver keeps a bitrate per mode)."""
        lo, hi, _ = self.rate_range()
        self.loading = True
        adj = self.rate.get_adjustment()
        adj.set_lower(lo)
        adj.set_upper(hi)
        self.loading = False

    # ------------------------------------------------------------ handlers

    def on_input(self, c):
        if c.get_active() >= 0 and not self.loading:
            self.apply("Input", "-i", str(c.get_active()))

    def on_output(self, c):
        i = c.get_active()
        if i < 0 or self.loading:
            return
        _, w, h = OUTPUTS[i]
        self.apply("Output size", "-v", "width=%d,height=%d" % (w, h))
        self.loading = True
        if i == 2 and self.mode.get_active() != 1:
            # 480x360 is VBR only: the driver uses its last VBR bitrate.
            self.mode.set_active(1)
            self.loading = False
            self.apply("Bitrate mode", "-c", "video_bitrate_mode=0")
            self.loading = True
        self.mode.set_sensitive(i != 2)
        self.loading = False
        self.limits_changed()

    def on_mode(self, c):
        """Only the mode: the driver uses the bitrate last set in that mode."""
        if c.get_active() >= 0 and not self.loading:
            self.limits_changed()
            self.apply("Bitrate mode", "-c",
                       "video_bitrate_mode=%d" % MODES[c.get_active()][1])

    def on_press(self, *_args):
        self.dragging = True
        return False

    def on_release(self, *_args):
        self.dragging = False
        return False

    def on_rate(self, _s):
        if self.loading:
            return
        if self.rate_timer:
            GLib.source_remove(self.rate_timer)
        self.rate_timer = GLib.timeout_add(400, self.rate_timeout)

    def rate_timeout(self):
        self.rate_timer = 0
        self.apply_rate()
        return False

    def on_profile(self, c):
        i = c.get_active()
        if i >= 0:
            self.apply("H.264 profile", "-c", "h264_profile=%d" % PROFILES[i][1])

    def on_stretch(self, sw, _param):
        self.apply("Stretch", "-c", "stretch_sd_input=%d" % int(sw.get_active()))


def main():
    if subprocess.run(["sh", "-c", "command -v v4l2-ctl"],
                      capture_output=True).returncode:
        print("gchd-settings-gui: v4l2-ctl is needed (package v4l-utils)",
              file=sys.stderr)
        return 1
    win = Window(sys.argv[1] if len(sys.argv) > 1 else None)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.load(quiet=True)  # hides the rows the input does not use
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
