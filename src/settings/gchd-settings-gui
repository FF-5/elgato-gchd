"""Elgato Game Capture HD settings: a window with the settings of the
elgato_gchd driver (input, output size, bitrate, stretch of SD input, for
HDMI and component "Allow 50/60 fps", for HDMI the colour range, picture
settings, analog audio gain). Changes are applied at once, also while a
program captures, and the driver remembers them. The window shows changes
made by other programs (it reads the device every 1.5 s). Profiles: named
sets of all settings, saved and loaded with gchd-profile.

    gchd-settings-gui [DEVICE]   DEVICE: default /dev/elgato-gchd, else the
                                 first device of the driver

Needs: python3-gi, gir1.2-gtk-3.0, v4l2-ctl (v4l-utils).
"""

import os
import re
import shutil
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

TITLE = "Elgato Game Capture HD"
INPUTS = ["HDMI", "Component", "Composite", "S-Video"]
OUTPUTS = [("720x480 NTSC / 720x576 PAL", 720, 480),
           ("640x480", 640, 480), ("480x360", 480, 360)]
RANGES = ["Standard", "Expanded"]
REFRESH_MS = 1500

# The bitrate is one slider in Mbit/s: below SWITCH variable (VBR, shown as
# the average, half the bitrate), from SWITCH constant (CBR, the bitrate) up
# to the output's highest bitrate (the driver's default value of the
# bitrate control). The lowest is 8/15 of the highest (as the average);
# 480x360 is VBR only, 2.00 to 7.50.
# kbit/s per 0.01 Mbit/s shown: CBR the bitrate (10), VBR the average (20).
SWITCH = 10.0

# Picture and audio settings: (label, control, lowest, highest); the audio
# gain applies to the analog audio (component, composite, S-video).
PICTURE = [("Brightness", "brightness", -100, 100),
           ("Contrast", "contrast", -100, 100),
           ("Saturation", "saturation", -100, 100),
           ("Hue (degrees)", "hue", -180, 180)]
AUDIO = ("Audio gain (dB)", "analog_audio_gain_db", -12, 12)


def profile_command():
    """gchd-profile: next to this program, else in PATH."""
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        "gchd-profile")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("gchd-profile")


def find_device():
    if os.path.exists("/dev/elgato-gchd"):
        return "/dev/elgato-gchd"
    base = "/sys/class/video4linux"
    try:
        names = sorted(os.listdir(base), key=lambda n: int(n[5:] or 0))
    except (OSError, ValueError):
        return None
    for name in names:
        drv = os.path.realpath(os.path.join(base, name, "device", "driver"))
        if os.path.basename(drv) == "elgato_gchd":
            return "/dev/" + name
    return None


class Device:
    """The driver's video device, through v4l2-ctl."""

    def __init__(self, path):
        self.path = path

    def run(self, *args):
        p = subprocess.run(["v4l2-ctl", "-d", self.path, *args],
                           capture_output=True, text=True)
        return p.returncode, p.stdout + p.stderr

    def read(self):
        """All settings in one call, or None when the device is gone."""
        rc, out = self.run("-I", "-V", "--list-framesizes", "MPEG", "-l", "-C",
                           "video_bitrate,video_bitrate_mode,"
                           "stretch_sd_input,allow_50_60_fps,hdmi_color_range," +
                           ",".join(c[1] for c in PICTURE + [AUDIO]))
        if rc != 0:
            return None

        def num(pattern, default):
            m = re.search(pattern, out)
            return int(m.group(1)) if m else default

        m = re.search(r"Width/Height\s*:\s*(\d+)/(\d+)", out)
        return {
            "input": num(r"Video input\s*:\s*(\d)", 0),
            "size": (int(m.group(1)), int(m.group(2))) if m else None,
            "bitrate": num(r"video_bitrate:\s*(\d+)", 11250000),
            "mode": num(r"video_bitrate_mode:\s*(\d+)", 1),
            "stretch": num(r"stretch_sd_input:\s*(\d+)", 0),
            "allow": num(r"allow_50_60_fps:\s*(\d+)", 1),
            "range": num(r"hdmi_color_range:\s*(\d+)", 0),
            "picture": {c[1]: num(r"%s:\s*(-?\d+)" % c[1], 0)
                        for c in PICTURE + [AUDIO]},
            # The output's highest bitrate: the bitrate control's default
            # (40 Mbit/s or more: no HDMI/component source seen yet).
            "rate_top": num(r"video_bitrate\s.*?default=(\d+)", 0),
            # Output sizes the source allows (HDMI/component: source size
            # first).
            "sizes": [(int(w), int(h)) for w, h in
                      re.findall(r"Discrete (\d+)x(\d+)", out)],
        }


class Window(Gtk.Window):
    def __init__(self, path):
        super().__init__(title=TITLE + " Settings")
        self.set_border_width(12)
        self.set_default_size(480, -1)
        self.fixed_path = path
        self.dev = None
        self.loading = False
        self.dragging = False
        self.rate_moved = False
        self.rate_timer = 0

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(box)

        # Profiles: choose one, then Load; Save as, Rename, Delete.
        self.profile_cmd = profile_command()
        self.profiles = []  # (name, input) in the list's order
        self.profiles_shown = []  # as shown (the list may be reordered)
        pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        prow = Gtk.Box(spacing=12)
        prow.pack_start(Gtk.Label(label="Profile", xalign=0), False, False, 0)
        self.profile = Gtk.ComboBoxText()
        self.profile.set_hexpand(True)
        self.profile.connect("changed", lambda _c: self.profile_buttons())
        prow.pack_start(self.profile, True, True, 0)
        pbox.pack_start(prow, False, False, 0)
        brow = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        self.p_load = Gtk.Button(label="Load")
        self.p_load.connect("clicked", self.on_profile_load)
        self.p_save = Gtk.Button(label="Save as...")
        self.p_save.connect("clicked", self.on_profile_save)
        self.p_rename = Gtk.Button(label="Rename...")
        self.p_rename.connect("clicked", self.on_profile_rename)
        self.p_delete = Gtk.Button(label="Delete")
        self.p_delete.connect("clicked", self.on_profile_delete)
        for b in (self.p_load, self.p_save, self.p_rename, self.p_delete):
            brow.pack_start(b, False, False, 0)
        pbox.pack_start(brow, False, False, 0)
        box.pack_start(pbox, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 0)

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        box.pack_start(grid, False, False, 0)

        def label(text, row):
            lab = Gtk.Label(label=text, xalign=0)
            grid.attach(lab, 0, row, 1, 1)
            return lab

        def combo(items, row, handler):
            c = Gtk.ComboBoxText()
            for text in items:
                c.append_text(text)
            c.set_hexpand(True)
            c.connect("changed", handler)
            grid.attach(c, 1, row, 1, 1)
            return c

        label("Device", 0)
        self.device_label = Gtk.Label(xalign=0)
        self.device_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        grid.attach(self.device_label, 1, 0, 1, 1)
        label("Input", 1)
        self.input = combo(INPUTS, 1, self.on_input)
        self.output_label = label("Output size", 2)
        self.output = combo([o[0] for o in OUTPUTS], 2, self.on_output)
        self.range_label = label("HDMI color range", 3)
        self.range = combo(RANGES, 3, self.on_range)

        self.rate_label = label("Bitrate", 4)
        self.rate = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 3.0, 11.25, 0.01)
        self.rate.set_digits(2)
        self.rate.set_value_pos(Gtk.PositionType.RIGHT)
        self.rate.connect("format-value", lambda _s, v: "%.2f Mbit/s %s" % (
            v, "VBR" if self.mobile() or v < SWITCH - 0.005 else "CBR"))
        self.rate.connect("value-changed", self.on_rate)
        self.rate.connect("button-press-event", self.on_press)
        self.rate.connect("button-release-event", self.on_release)
        grid.attach(self.rate, 1, 4, 1, 1)

        self.stretch_label = label("Stretch SD input", 6)
        self.stretch = Gtk.Switch(halign=Gtk.Align.START)
        self.stretch.connect("notify::active", self.on_stretch)
        grid.attach(self.stretch, 1, 6, 1, 1)
        self.allow_label = label("Allow 50/60 fps", 7)
        self.allow = Gtk.Switch(halign=Gtk.Align.START)
        self.allow.connect("notify::active", self.on_allow)
        grid.attach(self.allow, 1, 7, 1, 1)
        # Picture settings and audio gain: sliders, applied 0.4 s after the
        # last change (or where a dragged slider is released).
        self.pic = {}
        self.pic_timer = {}
        for row, (text, ctrl, lo, hi) in enumerate(PICTURE + [AUDIO], 8):
            lab = label(text, row)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
            sc.set_digits(0)
            sc.set_value_pos(Gtk.PositionType.RIGHT)
            sc.add_mark(0, Gtk.PositionType.BOTTOM, None)
            sc.connect("value-changed", self.on_pic, ctrl)
            grid.attach(sc, 1, row, 1, 1)
            self.pic[ctrl] = (lab, sc)
        reset = Gtk.Button(label="Reset picture")
        reset.set_halign(Gtk.Align.START)
        reset.connect("clicked", self.on_pic_reset)
        grid.attach(reset, 1, 8 + len(PICTURE) + 1, 1, 1)
        self.pic_reset = reset
        self.out_sizes = None  # HDMI/component: sizes in the output list
        self.top = None  # the output's highest bitrate in Mbit/s

        # Status next to the Close button.
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.set_max_width_chars(45)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _b: self.close())
        buttons = Gtk.Box(spacing=12)
        buttons.pack_start(self.status, True, True, 0)
        buttons.pack_end(close, False, False, 0)
        box.pack_end(buttons, False, False, 0)
        self.pending = 0  # device commands running
        self.status_timer = 0

        self.input_now = None
        self.load()
        self.load_profiles()
        GLib.timeout_add(REFRESH_MS, self.refresh)

    # ------------------------------------------------------------ state

    def busy_with_user(self):
        """True while the user is changing something (no refresh then)."""
        if self.dragging or self.rate_timer or self.pending or self.pic_timer:
            return True
        return any(c.get_property("popup-shown")
                   for c in (self.input, self.output, self.range, self.profile))

    def refresh(self):
        if not self.busy_with_user():
            self.load(quiet=True)
        return True

    def mobile(self):
        """480x360 is chosen (VBR only)."""
        i = self.output.get_active()
        if self.out_sizes is None:
            return i == 2
        return 0 <= i < len(self.out_sizes) and self.out_sizes[i] == (480, 360)

    def rate_range(self):
        """Slider range (Mbit/s shown) of the chosen output size."""
        if self.mobile():
            return 2.0, 7.5  # 4000-15000 kbit/s, every source
        top = self.top or 11.25
        return round(top * 8 / 15 / 2, 2), top

    def load(self, quiet=False):
        """Read the device's settings into the widgets."""
        path = self.fixed_path or find_device()
        vals = Device(path).read() if path and os.path.exists(path) else None
        self.loading = True
        try:
            if vals is None:
                self.dev = None
                self.device_label.set_text("not found")
                self.notify("No Elgato Game Capture HD found (driver "
                            "loaded, device plugged in?).", keep=True)
                self.set_controls(False)
                return
            was_missing = self.dev is None
            self.dev = Device(path)
            self.device_label.set_text(path)
            self.set_controls(True)
            self.set_active(self.input, vals["input"])
            if vals["input"] != self.input_now:
                self.input_now = vals["input"]
                self.load_profiles()
            analog = vals["input"] >= 2
            hd = vals["input"] <= 1
            if hd:
                # Resolutions the source allows; the source size first.
                sizes = vals["sizes"] or [vals["size"]]
                self.set_output_items(["%dx%d" % s for s in sizes], sizes)
                out = sizes.index(vals["size"]) if vals["size"] in sizes else 0
            else:
                self.set_output_items([o[0] for o in OUTPUTS], None)
                out = {(640, 480): 1, (480, 360): 2}.get(vals["size"], 0)
            self.set_active(self.output, out)
            # Stretch: composite/S-video; 50/60 fps: HDMI and component;
            # colour range: HDMI. The bitrate once its range is known
            # (HDMI/component: once a source was seen).
            for w in (self.stretch_label, self.stretch):
                w.set_visible(analog)
            top = vals["rate_top"]
            self.top = top / 1e6 if 0 < top < 40000000 else None
            for w in (self.rate_label, self.rate):
                w.set_visible(self.top is not None)
            for w in (self.allow_label, self.allow):
                w.set_visible(hd)
            for w in (self.range_label, self.range):
                w.set_visible(vals["input"] == 0)
            if self.allow.get_active() != bool(vals["allow"]):
                self.allow.set_active(bool(vals["allow"]))
            self.set_active(self.range, 1 if vals["range"] else 0)
            lo, hi = self.rate_range()
            vbr = self.mobile() or vals["mode"] == 0
            shown = vals["bitrate"] / (2000000 if vbr else 1000000)
            adj = self.rate.get_adjustment()
            adj.set_lower(lo)
            adj.set_upper(hi)
            if abs(self.rate.get_value() - shown) > 0.005:
                self.rate.set_value(min(max(shown, lo), hi))
            for ctrl, (lab, sc) in self.pic.items():
                if abs(sc.get_value() - vals["picture"][ctrl]) > 0.4:
                    sc.set_value(vals["picture"][ctrl])
            for w in self.pic[AUDIO[1]]:
                w.set_visible(not hd or vals["input"] == 1)
            if self.stretch.get_active() != bool(vals["stretch"]):
                self.stretch.set_active(bool(vals["stretch"]))
            if was_missing:
                self.notify("")
        finally:
            self.loading = False

    def notify(self, text, keep=False):
        """Notification next to the Close button; gone after 3 s unless
        KEEP (a state such as a missing device, or a change under way)."""
        if self.status_timer:
            GLib.source_remove(self.status_timer)
            self.status_timer = 0
        self.status.set_text(text)
        if text and not keep:
            self.status_timer = GLib.timeout_add(3000, self.clear_status)

    def clear_status(self):
        self.status_timer = 0
        self.status.set_text("")
        return False

    def set_output_items(self, labels, sizes):
        """Output list for the input (composite/S-video or HDMI/component)."""
        model = self.output.get_model()
        if sizes == self.out_sizes and len(model) == len(labels) and \
                all(model[i][0] == t for i, t in enumerate(labels)):
            return
        self.output.remove_all()
        for t in labels:
            self.output.append_text(t)
        self.out_sizes = sizes

    @staticmethod
    def set_active(combo, index):
        if combo.get_active() != index:
            combo.set_active(index)

    def set_controls(self, on):
        for w in (self.input, self.output, self.rate, self.range,
                  self.stretch, self.allow, self.pic_reset,
                  *(sc for _lab, sc in self.pic.values())):
            w.set_sensitive(on)
        self.device_ok = on
        self.profile_buttons()

    # ------------------------------------------------------------ profiles

    def run_profile(self, *args):
        p = subprocess.run([self.profile_cmd, *args], capture_output=True,
                           text=True)
        return p.returncode, (p.stdout + p.stderr).strip()

    def load_profiles(self, select=None):
        """The profile list: those of the current input first."""
        if not self.profile_cmd:
            self.profiles = []
        else:
            rc, out = self.run_profile("list")
            found = []
            for line in out.splitlines() if rc == 0 else []:
                name, _tab, inp = line.rpartition("\t")
                if name and inp.isdigit() and int(inp) < len(INPUTS):
                    found.append((name, int(inp)))
            found.sort(key=lambda p: (p[1] != self.input_now, p[0].lower()))
            self.profiles = found
        if select is None:
            i = self.profile.get_active()
            select = self.profiles_shown[i][0] if 0 <= i < len(
                getattr(self, "profiles_shown", [])) else None
        self.profiles_shown = list(self.profiles)
        self.profile.remove_all()
        for name, inp in self.profiles:
            self.profile.append_text("%s (%s)" % (name, INPUTS[inp]))
        names = [p[0] for p in self.profiles]
        self.profile.set_active(names.index(select) if select in names else
                                (0 if names else -1))
        self.profile_buttons()

    def chosen_profile(self):
        i = self.profile.get_active()
        return self.profiles_shown[i][0] if 0 <= i < len(self.profiles_shown) \
            else None

    def profile_buttons(self):
        have = self.profile_cmd is not None
        chosen = have and self.chosen_profile() is not None
        dev = getattr(self, "device_ok", False)
        self.profile.set_sensitive(have)
        self.p_load.set_sensitive(chosen and dev)
        self.p_save.set_sensitive(have and dev)
        self.p_rename.set_sensitive(chosen)
        self.p_delete.set_sensitive(chosen)
        if not have:
            self.profile.set_tooltip_text("gchd-profile is not installed")

    def message(self, kind, text, detail="", buttons=Gtk.ButtonsType.OK):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=kind, buttons=buttons, text=text)
        if detail:
            dialog.format_secondary_text(detail)
        r = dialog.run()
        dialog.destroy()
        return r

    def ask_name(self, title, default):
        """A profile name, or None."""
        dialog = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                           "OK", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(6)
        area.set_border_width(12)
        area.add(Gtk.Label(label="Profile name (letters, digits, space, "
                           "'.', '_', '-'):", xalign=0))
        entry = Gtk.Entry(text=default, activates_default=True, max_length=64)
        area.add(entry)
        dialog.show_all()
        r = dialog.run()
        name = entry.get_text().strip()
        dialog.destroy()
        if r != Gtk.ResponseType.OK or not name:
            return None
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9 ._-]{0,63}", name):
            self.message(Gtk.MessageType.WARNING, "Invalid profile name",
                         "Use letters, digits, space, '.', '_' and '-' "
                         "(not first), at most 64 characters.")
            return None
        return name

    def profile_work(self, what, args, done):
        """Run gchd-profile in the background; DONE(rc, out) afterwards."""
        self.pending += 1
        self.notify(what + " ...", keep=True)

        def work():
            rc, out = self.run_profile(*args)
            GLib.idle_add(finish, rc, out)

        def finish(rc, out):
            self.pending -= 1
            done(rc, out)
            if not self.pending:
                self.load(quiet=True)
            return False

        threading.Thread(target=work, daemon=True).start()

    def on_profile_load(self, _b):
        name = self.chosen_profile()
        if not name or not self.dev:
            return

        def done(rc, out):
            if rc == 0:
                self.notify("Profile '%s' loaded." % name)
            else:
                self.notify("Profile '%s' not loaded completely." % name)
                self.message(Gtk.MessageType.WARNING,
                             "Profile '%s' not loaded completely" % name, out)

        self.profile_work("Loading profile '%s'" % name,
                          ["-d", self.dev.path, "load", name], done)

    def on_profile_save(self, _b):
        if not self.dev:
            return
        name = self.ask_name("Save the settings as a profile",
                             self.chosen_profile() or "")
        if not name:
            return
        args = ["-d", self.dev.path, "save", name]
        if any(p[0] == name for p in self.profiles):
            if self.message(Gtk.MessageType.QUESTION,
                            "Replace profile '%s'?" % name,
                            "It gets the current settings.",
                            Gtk.ButtonsType.YES_NO) != Gtk.ResponseType.YES:
                return
            args.append("--replace")

        def done(rc, out):
            if rc == 0:
                self.notify("Profile '%s' saved." % name)
            else:
                self.notify("Profile '%s' not saved." % name)
                self.message(Gtk.MessageType.WARNING,
                             "Profile '%s' not saved" % name, out)
            self.load_profiles(select=name)

        self.profile_work("Saving profile '%s'" % name, args, done)

    def on_profile_rename(self, _b):
        old = self.chosen_profile()
        if not old:
            return
        new = self.ask_name("Rename profile '%s'" % old, old)
        if not new or new == old:
            return
        rc, out = self.run_profile("rename", old, new)
        if rc != 0:
            self.message(Gtk.MessageType.WARNING, "Profile not renamed", out)
        self.load_profiles(select=new if rc == 0 else old)

    def on_profile_delete(self, _b):
        name = self.chosen_profile()
        if not name or self.message(
                Gtk.MessageType.QUESTION, "Delete profile '%s'?" % name, "",
                Gtk.ButtonsType.YES_NO) != Gtk.ResponseType.YES:
            return
        rc, out = self.run_profile("delete", name)
        if rc != 0:
            self.message(Gtk.MessageType.WARNING, "Profile not deleted", out)
        else:
            self.notify("Profile '%s' deleted." % name)
        self.load_profiles()

    def apply(self, what, *args, side=False):
        """Run a change in the background (the device may take a while);
        report it (not a SIDE effect of the user's change), read the
        settings back, show a message box on an error."""
        if self.loading or not self.dev:
            return
        dev = self.dev
        self.pending += 1
        if not side:
            self.notify("Changing " + what.lower() + " ...", keep=True)

        def work():
            rc, out = dev.run(*args)
            GLib.idle_add(self.applied, what, rc, out, side)

        threading.Thread(target=work, daemon=True).start()

    def applied(self, what, rc, out, side):
        self.pending -= 1
        if rc == 0:
            if not side:
                self.notify(what + " changed.")
        else:
            self.notify(what + " not changed.")
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                       message_type=Gtk.MessageType.WARNING,
                                       buttons=Gtk.ButtonsType.OK,
                                       text=what + " not changed")
            dialog.format_secondary_text(out.strip())
            dialog.run()
            dialog.destroy()
        if not self.pending:
            self.load(quiet=True)
        return False

    def apply_rate(self):
        """Bitrate from the slider: below SWITCH VBR (the average shown, the
        bitrate twice it), from SWITCH CBR; 480x360 VBR only."""
        lo, hi = self.rate_range()
        value = min(max(self.rate.get_value(), lo), hi)
        vbr = self.mobile() or value < SWITCH - 0.005
        # Hundredths of Mbit/s, rounded half up (11.25 -> 11250 kbit/s).
        kb = int(value * 100 + 0.5) * (20 if vbr else 10)
        self.apply("Bitrate", "-c", "video_bitrate_mode=%d,video_bitrate=%d"
                   % (0 if vbr else 1, kb * 1000))

    def limits_changed(self):
        """New slider range after a size change (the value follows with the
        next read: the driver keeps the bitrate of every output mode)."""
        lo, hi = self.rate_range()
        self.loading = True
        adj = self.rate.get_adjustment()
        adj.set_lower(lo)
        adj.set_upper(hi)
        self.loading = False

    # ------------------------------------------------------------ handlers

    def on_input(self, c):
        if c.get_active() >= 0 and not self.loading:
            self.apply("Input", "-i", str(c.get_active()))

    def on_output(self, c):
        i = c.get_active()
        if i < 0 or self.loading:
            return
        if self.out_sizes is not None:
            # HDMI/component: the source size is requested as 1920x1080 (a
            # size that is never a scaled output, so it stays the source size).
            w, h = (1920, 1080) if i == 0 else self.out_sizes[i]
        else:
            _, w, h = OUTPUTS[i]
        # The driver loads the bitrate kept for the new output mode (read
        # back once applied).
        self.apply("Output size", "-v", "width=%d,height=%d" % (w, h))
        self.limits_changed()

    def on_range(self, c):
        if c.get_active() >= 0 and not self.loading:
            self.apply("HDMI color range", "-c",
                       "hdmi_color_range=%d" % c.get_active())

    def on_press(self, *_args):
        self.dragging = True
        return False

    def on_release(self, *_args):
        """A dragged slider is applied once, where it was released."""
        self.dragging = False
        if self.rate_moved:
            self.rate_moved = False
            self.apply_rate()
        return False

    def on_rate(self, _s):
        if self.loading:
            return
        if self.dragging:
            self.rate_moved = True
            return
        # Keys or the mouse wheel: applied 0.4 s after the last step.
        if self.rate_timer:
            GLib.source_remove(self.rate_timer)
        self.rate_timer = GLib.timeout_add(400, self.rate_timeout)

    def rate_timeout(self):
        self.rate_timer = 0
        self.apply_rate()
        return False

    def on_allow(self, sw, _param):
        self.apply("Allow 50/60 fps", "-c",
                   "allow_50_60_fps=%d" % int(sw.get_active()))

    def on_pic(self, sc, ctrl):
        if self.loading:
            return
        if ctrl in self.pic_timer:
            GLib.source_remove(self.pic_timer[ctrl])
        self.pic_timer[ctrl] = GLib.timeout_add(400, self.pic_timeout, ctrl)

    def pic_timeout(self, ctrl):
        del self.pic_timer[ctrl]
        name = next(c[0] for c in PICTURE + [AUDIO] if c[1] == ctrl)
        self.apply(name, "-c", "%s=%d" % (ctrl, round(self.pic[ctrl][1].get_value())))
        return False

    def on_pic_reset(self, _b):
        for t in self.pic_timer.values():
            GLib.source_remove(t)
        self.pic_timer.clear()
        self.loading = True
        for _t, ctrl, _lo, _hi in PICTURE:
            self.pic[ctrl][1].set_value(0)
        self.loading = False
        self.apply("Picture", "-c", ",".join("%s=0" % c[1] for c in PICTURE))

    def on_stretch(self, sw, _param):
        self.apply("Stretch", "-c", "stretch_sd_input=%d" % int(sw.get_active()))


def main():
    if subprocess.run(["sh", "-c", "command -v v4l2-ctl"],
                      capture_output=True).returncode:
        print("gchd-settings-gui: v4l2-ctl is needed (package v4l-utils)",
              file=sys.stderr)
        return 1
    win = Window(sys.argv[1] if len(sys.argv) > 1 else None)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.load(quiet=True)  # hides the rows the input does not use
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
