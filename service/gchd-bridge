#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# gchd-bridge: feeds the application device of the elgato_gchd driver
# ("Elgato Game Capture HD", uncompressed YUYV) for applications such as
# guvcview, OBS, browsers and video calls, and offers the audio as a
# PipeWire/PulseAudio source "Elgato Game Capture HD".
#
#   gchd-bridge run                 run the service (foreground)
#   gchd-bridge input INPUT         select the input: hdmi, component,
#                                   composite, svideo (or 0-3)
#   gchd-bridge status              show the devices and the state
#
# The driver publishes the state of its application device in the sysfs
# attribute "app" of the USB interface:
#   STATE APP-NODE WIDTH HEIGHT RATE-NUM RATE-DEN FEED-NODE STREAM-NODE
# While STATE is "streaming" (an application streams from the application
# device), the service reads the transport stream of the driver's H.264
# device, decodes and deinterlaces it (one frame per field) with ffmpeg,
# and writes YUYV frames of the application format into the feed device;
# the audio goes to the audio source. When the application stops, the
# service stops ffmpeg and the capture device switches off. When the
# format changes (the driver registers the application device again), the
# service restarts ffmpeg with the new format.
#
# Needs: ffmpeg, v4l2-ctl, pactl (optional, for the audio).
# Environment: GCHD_DEINTERLACE (ffmpeg filter, default
# "bwdif=mode=send_field:deint=interlaced").

set -u

DEINTERLACE=${GCHD_DEINTERLACE:-bwdif=mode=send_field:deint=interlaced}
SINK=elgato_gchd
SOURCE=elgato_gchd_audio
AUDIO_DESC="Elgato Game Capture HD"
POLL=0.5           # seconds between checks of the driver state
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}/gchd-bridge-$(id -u)
PIDFILE=$STATE_DIR/pid

msg() { printf 'gchd-bridge: %s\n' "$*" >&2; }
die() { msg "$*"; exit 1; }

# ------------------------------------------------------------ devices

# sysfs directory of the driver's USB interface (first device).
intf_dir() {
	local f
	for f in /sys/bus/usb/drivers/elgato_gchd/*/app; do
		[ -e "$f" ] && { dirname "$f"; return 0; }
	done
	return 1
}

# Driver state:
# STATE APP-NODE WIDTH HEIGHT RATE-NUM RATE-DEN FEED-NODE STREAM-NODE.
app_state() {
	cat "$1/app" 2>/dev/null
}

input_number() {
	case "$1" in
	0|hdmi|HDMI) echo 0 ;;
	1|component) echo 1 ;;
	2|composite) echo 2 ;;
	3|svideo|s-video) echo 3 ;;
	*) return 1 ;;
	esac
}

# ------------------------------------------------------------ audio

AUDIO_MODULES=
audio_setup() {
	local m1 m2
	command -v pactl >/dev/null || { msg "pactl missing: no audio source"; return; }
	pactl list short sinks 2>/dev/null | grep -q "	$SINK	" && return
	m1=$(pactl load-module module-null-sink sink_name=$SINK \
		"sink_properties=device.description=\"$AUDIO_DESC (bridge)\"") || return
	m2=$(pactl load-module module-remap-source master=$SINK.monitor \
		source_name=$SOURCE \
		"source_properties=device.description=\"$AUDIO_DESC\"") || m2=
	AUDIO_MODULES="$m2 $m1"
}

audio_cleanup() {
	local m
	for m in $AUDIO_MODULES; do
		pactl unload-module "$m" 2>/dev/null
	done
}

# ------------------------------------------------------------ pipeline

PID=        # running ffmpeg
FORMAT=     # "WIDTH HEIGHT NUM DEN" ffmpeg was started with

# Stop ffmpeg: TERM, then KILL after 3 s (an ffmpeg that waits for data
# from an input without signal may not react to TERM).
stop_pipeline() {
	local _
	[ -n "$PID" ] || return 0
	kill "$PID" 2>/dev/null
	for _ in 1 2 3 4 5 6; do
		kill -0 "$PID" 2>/dev/null || break
		sleep 0.5
	done
	if kill -0 "$PID" 2>/dev/null; then
		msg "ffmpeg $PID did not stop; killing it"
		kill -KILL "$PID" 2>/dev/null
	fi
	wait "$PID" 2>/dev/null
	PID=
	FORMAT=
	msg "capture stopped"
}

# Decode the transport stream, deinterlace, scale to the application
# format, write YUYV frames to the feed device and the audio to the sink.
start_pipeline() {	# start_pipeline TS FEED W H NUM DEN
	local audio=()
	v4l2-ctl -d "$1" -v "width=$3,height=$4,pixelformat=MPEG" >/dev/null 2>&1 ||
		msg "cannot set the transport stream format on $1"
	if pactl list short sinks 2>/dev/null | grep -q "	$SINK	"; then
		audio=(-map '0:a:0?' -f pulse -device "$SINK" "$AUDIO_DESC")
	fi
	ffmpeg -hide_banner -loglevel error -nostdin \
		-fflags nobuffer -probesize 1000000 -analyzeduration 1000000 \
		-f mpegts -i "$1" \
		-map 0:v:0 -vf "$DEINTERLACE,scale=$3:$4,setsar=1,fps=$5/$6,format=yuyv422" \
		-f v4l2 "$2" "${audio[@]}" &
	PID=$!
	FORMAT="$3 $4 $5 $6"
	msg "capture: $1 -> $2 ($3x$4, $5/$6 frames/s)"
}

# ------------------------------------------------------------ service

cleanup() {
	stop_pipeline
	audio_cleanup
	rm -f "$PIDFILE"
	exit 0
}

run() {
	local dir ts state w h num den feed
	mkdir -p "$STATE_DIR"
	echo $$ > "$PIDFILE"
	trap cleanup INT TERM
	audio_setup

	while :; do
		state=
		dir=$(intf_dir) && state=$(app_state "$dir")
		# shellcheck disable=SC2086
		set -- $state
		state=${1:-none} w=${3:-} h=${4:-} num=${5:-} den=${6:-} feed=${7:--} ts=${8:--}

		if [ "$state" = streaming ]; then
			if [ -n "$PID" ] && [ "$FORMAT" != "$w $h $num $den" ]; then
				msg "format now ${w}x$h, $num/$den"
				stop_pipeline
			fi
			if [ -z "$PID" ] && [ "$ts" != - ] && [ "$feed" != - ]; then
				start_pipeline "/dev/$ts" "/dev/$feed" "$w" "$h" "$num" "$den"
			fi
		elif [ -n "$PID" ]; then
			stop_pipeline
		fi

		# ffmpeg that ended by itself (source lost, error) is started
		# again by the next round while the application streams.
		if [ -n "$PID" ] && ! kill -0 "$PID" 2>/dev/null; then
			wait "$PID" 2>/dev/null
			msg "ffmpeg ended"
			PID=
			FORMAT=
			sleep 1
		fi

		sleep "$POLL" &
		wait $! 2>/dev/null
	done
}

select_input() {
	local n dir node
	n=$(input_number "${1:-}") || die "unknown input: ${1:-} (hdmi, component, composite, svideo)"
	dir=$(intf_dir) || die "Elgato Game Capture HD not found"
	# shellcheck disable=SC2046
	set -- $(app_state "$dir")
	node=${2:--}
	[ "$node" != - ] || die "application device not registered (format change in progress)"
	v4l2-ctl -d "/dev/$node" -i "$n"
}

status() {
	local dir pid
	if dir=$(intf_dir); then
		echo "driver state:   $(app_state "$dir")"
	else
		echo "driver state:   no device"
	fi
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		echo "service:        running (pid $pid)"
	else
		echo "service:        not running"
	fi
}

case "${1:-}" in
run) run ;;
input) select_input "${2:-}" ;;
status) status ;;
*) sed -n '4,10p' "$0"; exit 2 ;;
esac
