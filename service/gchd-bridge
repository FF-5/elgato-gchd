#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# gchd-bridge: feeds the application device of the elgato_gchd driver
# ("Elgato Game Capture HD", uncompressed YUYV, registered while the module
# is loaded) for applications such as guvcview, OBS, browsers and video
# calls, and offers the audio as a PipeWire/PulseAudio source "Elgato Game
# Capture HD".
#
#   gchd-bridge run                 run the service (foreground)
#   gchd-bridge input INPUT         select the input: hdmi, component,
#                                   composite, svideo (or 0-3)
#   gchd-bridge status              show the devices and the state
#
# The driver publishes the state in the sysfs attribute "gchd_state" of the
# application device:
#   STATE WIDTH HEIGHT RATE-NUM RATE-DEN FEED-NODE STREAM-NODE
# While STATE is "streaming" (an application streams from the application
# device), the service writes YUYV frames of that format (the source
# format) into the frame input device: from the H.264 device STREAM-NODE of
# the attached Game Capture HD (decoded, deinterlaced one frame per field,
# not scaled; after a source change while streaming the picture is placed
# in the middle, with black borders or cropped; the audio goes to the audio
# source), or a "Please connect" picture while no Game Capture HD is
# attached. When the application stops, ffmpeg stops and the capture device
# switches off.
#
# The service sleeps until the driver reports a change (a "change" uevent of
# the application device, through udevadm monitor); without udevadm it
# checks every 0.5 s.
#
# Needs: ffmpeg, v4l2-ctl, pactl (optional, for the audio).
# Environment: GCHD_DEINTERLACE (ffmpeg filter, default
# "bwdif=mode=send_field:deint=interlaced").

set -u

DEINTERLACE=${GCHD_DEINTERLACE:-bwdif=mode=send_field:deint=interlaced}
SINK=elgato_gchd
SOURCE=elgato_gchd_audio
AUDIO_DESC="Elgato Game Capture HD"
POLL=0.5           # seconds between checks without udevadm
IDLE_WAIT=30       # longest sleep while no application streams
BUSY_WAIT=1        # longest sleep while ffmpeg runs (to notice its end)
CONNECT_TEXT="Please connect the Elgato Game Capture HD"
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}/gchd-bridge-$(id -u)
PIDFILE=$STATE_DIR/pid

msg() { printf 'gchd-bridge: %s\n' "$*" >&2; }
die() { msg "$*"; exit 1; }

# ------------------------------------------------------------ devices

# sysfs directory of the application device.
app_dir() {
	local f
	for f in /sys/class/video4linux/video*/gchd_state; do
		[ -e "$f" ] && { dirname "$f"; return 0; }
	done
	return 1
}

# Driver state:
# STATE WIDTH HEIGHT RATE-NUM RATE-DEN FEED-NODE STREAM-NODE.
app_state() {
	cat "$1/gchd_state" 2>/dev/null
}

input_number() {
	case "$1" in
	0|hdmi|HDMI) echo 0 ;;
	1|component) echo 1 ;;
	2|composite) echo 2 ;;
	3|svideo|s-video) echo 3 ;;
	*) return 1 ;;
	esac
}

# ------------------------------------------------------------ audio

AUDIO_MODULES=
audio_setup() {
	local m1 m2
	command -v pactl >/dev/null || { msg "pactl missing: no audio source"; return; }
	pactl list short sinks 2>/dev/null | grep -q "	$SINK	" && return
	m1=$(pactl load-module module-null-sink sink_name=$SINK \
		"sink_properties=device.description=\"$AUDIO_DESC (bridge)\"") || return
	m2=$(pactl load-module module-remap-source master=$SINK.monitor \
		source_name=$SOURCE \
		"source_properties=device.description=\"$AUDIO_DESC\"") || m2=
	AUDIO_MODULES="$m2 $m1"
}

audio_cleanup() {
	local m
	for m in $AUDIO_MODULES; do
		pactl unload-module "$m" 2>/dev/null
	done
}

# ------------------------------------------------------------ pipeline

PID=        # running ffmpeg
FORMAT=     # "WIDTH HEIGHT NUM DEN STREAM-NODE" ffmpeg was started with

# Stop ffmpeg: TERM, then KILL after 3 s (an ffmpeg that waits for data
# from an input without signal may not react to TERM).
stop_pipeline() {
	local _
	[ -n "$PID" ] || return 0
	kill "$PID" 2>/dev/null
	for _ in 1 2 3 4 5 6; do
		kill -0 "$PID" 2>/dev/null || break
		sleep 0.5
	done
	if kill -0 "$PID" 2>/dev/null; then
		msg "ffmpeg $PID did not stop; killing it"
		kill -KILL "$PID" 2>/dev/null
	fi
	wait "$PID" 2>/dev/null
	PID=
	FORMAT=
	msg "capture stopped"
}

# Decode the transport stream, deinterlace, place the picture 1:1 in the
# application format (unchanged when the sizes match; centred with black
# borders or cropped after a source change while streaming), write YUYV
# frames to the feed device and the audio to the sink.
start_pipeline() {	# start_pipeline TS FEED W H NUM DEN
	local audio=()
	v4l2-ctl -d "$1" -v "width=$3,height=$4,pixelformat=MPEG" >/dev/null 2>&1 ||
		msg "cannot set the transport stream format on $1"
	if pactl list short sinks 2>/dev/null | grep -q "	$SINK	"; then
		audio=(-map '0:a:0?' -f pulse -device "$SINK" "$AUDIO_DESC")
	fi
	ffmpeg -hide_banner -loglevel error -nostdin \
		-fflags nobuffer -probesize 1000000 -analyzeduration 1000000 \
		-f mpegts -i "$1" \
		-map 0:v:0 -vf "$DEINTERLACE,crop='min(iw,$3)':'min(ih,$4)',pad=$3:$4:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=$5/$6,format=yuyv422" \
		-f v4l2 "$2" "${audio[@]}" &
	PID=$!
	msg "capture: $1 -> $2 ($3x$4, $5/$6 frames/s)"
}

# "Please connect" picture while no Game Capture HD is attached (black
# without the drawtext filter).
start_black() {	# start_black FEED W H NUM DEN
	local vf=format=yuyv422
	if ffmpeg -hide_banner -filters 2>/dev/null | grep -qw drawtext; then
		vf="drawtext=text='$CONNECT_TEXT':font=Sans:fontcolor=white:fontsize='min(h/18\,w/26)':x=(w-text_w)/2:y=(h-text_h)/2,$vf"
	fi
	ffmpeg -hide_banner -loglevel error -nostdin \
		-re -f lavfi -i "color=c=black:s=$2x$3:r=$4/$5" \
		-vf "$vf" -f v4l2 "$1" &
	PID=$!
	msg "no Game Capture HD: picture $2x$3 -> $1"
}

# ------------------------------------------------------------ waiting

MON_PID=
MON_FD=
# Kernel uevents of video devices (the driver's state changes, plug-in,
# unplug) through udevadm monitor.
monitor_start() {
	command -v udevadm >/dev/null || { msg "udevadm missing: checking every $POLL s"; return; }
	coproc MON { exec udevadm monitor --kernel --subsystem-match=video4linux 2>/dev/null; }
	MON_FD=${MON[0]}
}

# Sleep until a uevent arrives (at most SECONDS), then read the ones queued.
wait_change() {	# wait_change SECONDS
	if [ -n "$MON_PID" ] && kill -0 "$MON_PID" 2>/dev/null; then
		read -r -t "$1" -u "$MON_FD" _ || return 0
		# Read what else is queued (bounded: a burst does not keep us here).
		local _n
		for _n in $(seq 50); do
			read -r -t 0.05 -u "$MON_FD" _ || break
		done
	else
		sleep "$POLL" &
		wait $! 2>/dev/null
	fi
}

# ------------------------------------------------------------ service

cleanup() {
	[ -n "$MON_PID" ] && kill "$MON_PID" 2>/dev/null
	stop_pipeline
	audio_cleanup
	rm -f "$PIDFILE"
	exit 0
}

run() {
	local dir state w h num den feed ts
	mkdir -p "$STATE_DIR"
	echo $$ > "$PIDFILE"
	trap cleanup INT TERM
	audio_setup
	monitor_start

	while :; do
		state=
		dir=$(app_dir) && state=$(app_state "$dir")
		# shellcheck disable=SC2086
		set -- $state
		state=${1:-none} w=${2:-} h=${3:-} num=${4:-} den=${5:-} feed=${6:--} ts=${7:--}

		if [ "$state" = streaming ] && [ "$feed" != - ]; then
			if [ -n "$PID" ] && [ "$FORMAT" != "$w $h $num $den $ts" ]; then
				msg "now ${w}x$h, $num/$den, stream device $ts"
				stop_pipeline
			fi
			if [ -z "$PID" ]; then
				if [ "$ts" != - ]; then
					start_pipeline "/dev/$ts" "/dev/$feed" "$w" "$h" "$num" "$den"
				else
					start_black "/dev/$feed" "$w" "$h" "$num" "$den"
				fi
				FORMAT="$w $h $num $den $ts"
			fi
		elif [ -n "$PID" ]; then
			stop_pipeline
		fi

		# ffmpeg that ended by itself (source lost, error) is started
		# again by the next round while the application streams.
		if [ -n "$PID" ] && ! kill -0 "$PID" 2>/dev/null; then
			wait "$PID" 2>/dev/null
			msg "ffmpeg ended"
			PID=
			FORMAT=
			sleep 1
		fi

		if [ -n "$PID" ]; then
			wait_change $BUSY_WAIT
		else
			wait_change $IDLE_WAIT
		fi
	done
}

select_input() {
	local n dir
	n=$(input_number "${1:-}") || die "unknown input: ${1:-} (hdmi, component, composite, svideo)"
	dir=$(app_dir) || die "application device not found (module not loaded?)"
	v4l2-ctl -d "/dev/$(basename "$dir")" -i "$n"
}

status() {
	local dir pid
	if dir=$(app_dir); then
		echo "application:    /dev/$(basename "$dir")"
		echo "driver state:   $(app_state "$dir")"
	else
		echo "driver state:   module not loaded"
	fi
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		echo "service:        running (pid $pid)"
	else
		echo "service:        not running"
	fi
}

case "${1:-}" in
run) run ;;
input) select_input "${2:-}" ;;
status) status ;;
*) sed -n '4,10p' "$0"; exit 2 ;;
esac
