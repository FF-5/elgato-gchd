# Remembered settings of the elgato_gchd kernel driver.
#
# The driver sends a "change" uevent with its settings (GCHD_*) whenever an
# application changes the input, the output size, the pixel format or an
# encoder control. This rule writes them as module options, so the next load
# of the module (unplug, reload, reboot) starts with the same settings.
#
# Install: copy to /etc/udev/rules.d/ and run "udevadm control --reload".
# Forget the settings: delete /etc/modprobe.d/elgato-gchd-settings.conf.

ACTION=="change", SUBSYSTEM=="usb", ENV{GCHD_INPUT}=="?*", \
  RUN+="/bin/sh -c 'echo options elgato_gchd input=$env{GCHD_INPUT} output=$env{GCHD_OUTPUT} format=$env{GCHD_FORMAT} bitrate_mode=$env{GCHD_BITRATE_MODE} bitrate_cbr=$env{GCHD_BITRATE_CBR} bitrate_vbr=$env{GCHD_BITRATE_VBR} stretch=$env{GCHD_STRETCH} h264_profile=$env{GCHD_H264_PROFILE} h264_level=$env{GCHD_H264_LEVEL} std_composite=$env{GCHD_STD_COMPOSITE} std_svideo=$env{GCHD_STD_SVIDEO} hd_bitrate_mode=$env{GCHD_HD_BITRATE_MODE} hd_bitrate_cbr=$env{GCHD_HD_BITRATE_CBR} hd_bitrate_vbr=$env{GCHD_HD_BITRATE_VBR} hd_h264_profile=$env{GCHD_HD_H264_PROFILE} hd_h264_level=$env{GCHD_HD_H264_LEVEL} > /etc/modprobe.d/elgato-gchd-settings.conf'"
