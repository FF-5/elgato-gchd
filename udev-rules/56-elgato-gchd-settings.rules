# Remembered settings of the elgato_gchd kernel driver.
#
# The driver sends a "change" uevent with its settings (GCHD_*) whenever an
# application changes the input, the output size, the pixel format or an
# encoder control. This rule writes them as module options, so the next load
# of the module (unplug, reload, reboot) starts with the same settings.
#
# Install: copy to /etc/udev/rules.d/ and run "udevadm control --reload".
# Forget the settings: delete /etc/modprobe.d/elgato-gchd-settings.conf.

ACTION=="change", SUBSYSTEM=="usb", ENV{GCHD_INPUT}=="?*", \
  RUN+="/bin/sh -c 'echo options elgato_gchd input=$env{GCHD_INPUT} output=$env{GCHD_OUTPUT} format=$env{GCHD_FORMAT} out_bitrate_mode=$env{GCHD_OUT_BITRATE_MODE} out_bitrate_cbr=$env{GCHD_OUT_BITRATE_CBR} out_bitrate_vbr=$env{GCHD_OUT_BITRATE_VBR} stretch=$env{GCHD_STRETCH} hd_output=$env{GCHD_HD_OUTPUT} allow_5060=$env{GCHD_ALLOW_5060} hdmi_range=$env{GCHD_HDMI_RANGE} picture=$env{GCHD_PICTURE} audio_gain=$env{GCHD_AUDIO_GAIN} std_composite=$env{GCHD_STD_COMPOSITE} std_svideo=$env{GCHD_STD_SVIDEO} > /etc/modprobe.d/elgato-gchd-settings.conf'"
