#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# Extract the Elgato Game Capture HD firmware from Elgato's "Game Capture"
# installer for Windows (GameCaptureSetup*.msi) into /lib/firmware/gchd/.
#
#   extract_firmware_windows [PATH/TO/GameCaptureSetup.msi]
#
# Without an argument the installer is taken from this directory
# (firmware/). Needs 7z (p7zip). Exits with status 0 when all firmware
# files are in place, 1 otherwise.

FIRMWARE_DIR=/lib/firmware/gchd
FILES="MB86H57_H58_IDLE MB86H57_H58_ENC_H MB86M01_ASSP_NSEC_IDLE MB86M01_ASSP_NSEC_ENC_H"
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

fail() { echo "Firmware: $*" >&2; exit 1; }

type 7z >/dev/null 2>&1 || fail "7z is needed (package p7zip-full, p7zip or 7zip)."

msi=${1:-}
if [ -z "$msi" ]; then
	for f in "$HERE"/GameCaptureSetup*.msi; do
		[ -f "$f" ] && { msi=$f; break; }
	done
fi
[ -n "$msi" ] && [ -f "$msi" ] || fail "no GameCaptureSetup*.msi found. Download Elgato's \"Game Capture\" software for Windows and put the .msi file into $HERE, or give its path as argument."

if [ "$(id -u)" != 0 ]; then
	exec sudo "$0" "$msi"
fi

echo "Firmware: extracting from $msi"
tmp=$(mktemp -d) || fail "cannot create a temporary directory"
trap 'rm -rf "$tmp"' EXIT

7z e -y -o"$tmp" "$msi" x86_yPushFile3.dll >/dev/null ||
	fail "x86_yPushFile3.dll not found in $msi (not the Game Capture HD installer?)"
mkdir -p "$FIRMWARE_DIR" || fail "cannot create $FIRMWARE_DIR"
# shellcheck disable=SC2086
7z e -y -o"$FIRMWARE_DIR" -r "$tmp/x86_yPushFile3.dll" $FILES >/dev/null ||
	fail "extraction from x86_yPushFile3.dll failed"

missing=
for f in $FILES; do
	[ -s "$FIRMWARE_DIR/$f" ] || missing="$missing $f"
done
[ -z "$missing" ] || fail "missing after extraction:$missing"

echo "Firmware: installed to $FIRMWARE_DIR"
exit 0
